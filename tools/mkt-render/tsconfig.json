{
  // Two very different environments live in this package, so the compiler
  // settings have to admit both:
  //
  //   src/      Node. Drives Playwright, writes files. No DOM.
  //   harness/  Browser. Imports the CRM's real renderers, which are full of
  //             canvas, Image, MediaRecorder and Blob.
  //
  // One config covers both, because splitting them does not actually work
  // here: src/renderer.ts drives Playwright, whose page.evaluate callbacks
  // reference `window` and so need the DOM lib even though the file runs on
  // Node.
  //
  // The cost is one real collision — with both the DOM lib and @types/node
  // loaded, TS resolves `fetch` to the DOM's signature while the code runs on
  // Node's, so a Uint8Array body needs an explicit cast (see src/index.ts).
  // That is the only place it bites.
  //
  // What matters most is that this file is wired into the root
  // `npm run typecheck`; a bare `tsc -p tsconfig.json` at the repo root checks
  // ZERO files here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "harness/**/*.ts", "vite.config.ts"]
}
