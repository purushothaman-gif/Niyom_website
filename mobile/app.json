{
  "expo": {
    "name": "Niyom Wealth",
    "slug": "niyom-wealth",
    "scheme": "niyomwealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#071524",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071524",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#071524"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.niyomwealth.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your Niyom Wealth account without typing your PIN.",
        "NSCameraUsageDescription": "Niyom Wealth needs the camera so you can photograph your KYC documents.",
        "NSPhotoLibraryUsageDescription": "Niyom Wealth needs photo access so you can attach KYC documents you have already saved.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.niyomwealth.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#071524",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#071524",
          "dark": { "backgroundColor": "#071524" }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Niyom Wealth account without typing your PIN."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Niyom Wealth needs photo access so you can attach KYC documents you have already saved.",
          "cameraPermission": "Niyom Wealth needs the camera so you can photograph your KYC documents."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" },
          "android": { "minSdkVersion": 24 }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
