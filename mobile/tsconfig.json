{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": true,
    // The shared investor-profile rules live under the edge functions, where
    // Deno requires explicit `.ts` import extensions. Metro resolves them as
    // written; this lets the type checker accept them too (it never emits).
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // No `baseUrl`: TypeScript 6 deprecates it, and paths already resolve
    // relative to this file. Kept in step with babel.config.js's aliases.
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      /*
       * Files under shared/ sit outside this project, so TypeScript would walk
       * UP from them and resolve these to the WEBSITE's node_modules — a second
       * copy of each library with its own class identities, which makes a
       * perfectly valid SupabaseClient fail to satisfy `SupabaseClient`.
       * Pinning them here matches what metro.config.js already does at runtime.
       */
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../shared/**/*.ts"
  ],
  // shared/mail is the email renderer shared with the Deno edge functions: it
  // uses Deno-style `.ts` import paths and the app never imports it.
  "exclude": ["node_modules", ".expo", "dist", "../shared/mail"]
}
