# Niyom Wealth mobile app — the SAME Supabase project the website uses.
# Public, publishable values only: they ship inside every built app anyway.
# Mirrors the website's .env (VITE_* -> EXPO_PUBLIC_*).

EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>
EXPO_PUBLIC_BSE_PROXY_URL=https://api.niyomwealth.com
EXPO_PUBLIC_BSE_MODE=live
