# NIYOM BSE Proxy — environment template. Copy to .env on the droplet and fill.
# NEVER commit the real .env.

# demo | prod  (demo = https://starmfv2demo.bseindia.com/api)
BSE_ENV=demo
# Optional override; normally derived from BSE_ENV
# BSE_BASE_URL=

# BSE StAR MF 2.0 API credentials (from BSE onboarding — sandbox first)
BSE_USERNAME=
BSE_PASSWORD=
BSE_MEMBER_CODE=

# REQUIRED IN PRODUCTION (demo ignores it). Format:
#   member/<member code>:<base64 SHA-256 of the SPKI DER of our public key>
# Derive the fingerprint with:
#   openssl rsa -pubin -in bse_jose_public.pem -outform DER \
#     | openssl dgst -sha256 -binary | base64
# BSE must have registered that key for the environment you are pointing at —
# a key registered only for demo returns errcode org_key_not_found in prod.
BSE_ORG_ID=

# Encrypt request payloads with JOSE (spec 6.1.7). PRODUCTION MANDATES THIS;
# demo accepts plain JSON. Keys default to /home/niyom/bse-keys/.
BSE_JOSE=false
# BSE_JOSE_PRIVATE_KEY=/home/niyom/bse-keys/bse_jose_private.pem
# BSE_JOSE_REMOTE_KEY=/home/niyom/bse-keys/bse_public_demo_prod.pem

# EUIN declared on every order/SIP as mem_details. Used when the caller has no
# EUIN of their own — an employee without one, or a client placing their own
# order from the portal. Per-employee EUINs live in nw_employees.euin.
# No ARN here: BSE derives broker_code from the member record itself.
BSE_DEFAULT_EUIN=E124361

# Port the proxy listens on (nginx proxies 443 → this)
PORT=8080

# Comma-separated browser origins allowed to call this proxy
ALLOWED_ORIGINS=https://www.niyomwealth.com,https://niyomwealth.com,http://localhost:5173

# Supabase (used ONLY to verify the caller's session JWT)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase service-role key — enables webhook persistence to bse_webhook_events.
# Supabase -> Project Settings -> API -> service_role. Empty = persistence off
# (webhook still returns 200 + logs).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated BSE webhook source IPs allowed to POST /webhooks/*.
# Empty = allow all (log only). Set once BSE shares its outbound webhook IPs.
WEBHOOK_ALLOWED_IPS=

# Set to false only for local smoke tests without a Supabase session
REQUIRE_AUTH=true

# --- Cashfree PAN verification relay (POST /verify/pan) ---
# This droplet's static IP is whitelisted in Cashfree; the Supabase edge
# function calls /verify/pan with the shared secret below.
# Shared secret the edge function must send as `x-relay-secret` (generate a
# long random string, e.g. `openssl rand -hex 32`).
PAN_RELAY_SECRET=
# Cashfree VERIFICATION SUITE keys (separate from the Payments keys).
CASHFREE_VERIFY_CLIENT_ID=
CASHFREE_VERIFY_SECRET_KEY=
# production | sandbox  (default: production)
CASHFREE_VERIFY_ENV=production
